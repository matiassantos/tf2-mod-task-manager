-- ========================================
-- GAME INTERFACE (Transport Fever 1 style)
-- ========================================

---@class game.interface
game.interface = {}

---Obtiene entidades en un área
---@param area {pos: number[], radius: number} Área de búsqueda
---@param filter {type: string} Filtro por tipo de entidad
---@return integer[] Lista de IDs de entidades
function game.interface.getEntities(area, filter) end

---Obtiene información de una entidad
---@param entityId integer ID de la entidad
---@return table Información de la entidad
function game.interface.getEntity(entityId) end

-- ========================================
-- FUNCIONES GLOBALES
-- ========================================

---Imprime debug de una tabla
---@param table table Tabla a imprimir
function debugPrint(table) end

---Función print estándar
---@param ... any Valores a imprimir
function print(...) end

-- ========================================
-- EJEMPLOS DE USO
-- ========================================

--[[
-- Ejemplo 1: Crear un slider
local slider = api.gui.comp.Slider.new("HORIZONTAL")
slider:onValueChanged(function(value)
    print("Nuevo valor:", value)
end)

-- Ejemplo 2: Enviar comando
local cmd = api.cmd.make.spawnAnimal("animal/bird_eagle.mdl", api.type.Vec2f.new(50, 50))
api.cmd.sendCommand(cmd, function(result, valid)
    if valid then
        print("Animal creado exitosamente")
    end
end)

-- Ejemplo 3: Obtener entidades
local buildings = game.interface.getEntities(
    { pos = {0, 0}, radius = math.huge },
    { type = "SIM_BUILDING" }
)

for i = 1, #buildings do
    local entity = game.interface.getEntity(buildings[i])
    print("Edificio:", entity.fileName)
end

-- Ejemplo 4: Pathfinding
local edge1 = api.type.EdgeId.new(170679, 0)
local node1 = api.type.NodeId.new(171540, 0)
local path = api.engine.util.pathfinding.findPath(
    { api.type.EdgeIdDirAndLength.new(edge1, true, 0.0) },
    { node1 },
    {},
    1000
)
--]]