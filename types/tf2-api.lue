---@diagnostic disable: lowercase-global

-- Transport Fever 2 API Type Definitions
-- Para usar IntelliSense en VSCode, incluye este archivo en tu proyecto

---@class api
api = {}

---@class app
app = {}

---@class game
game = {}

-- ========================================
-- API.CMD - Comandos del juego
-- ========================================

---@class api.cmd
api.cmd = {}

---@class api.cmd.make
api.cmd.make = {}

---Envía un comando para ser ejecutado
---@param command table El comando a ejecutar
---@param callback? function Función de callback que recibe (cmd, valid)
---@return function Callback para cancelar el comando
function api.cmd.sendCommand(command, callback) end

---Crea un comando para reemplazar un vehículo
---@param vehicleEntity integer ID de la entidad del vehículo
---@param config TransportVehicleConfig Configuración del nuevo vehículo
---@return table Comando SendToDepot
function api.cmd.make.replaceVehicle(vehicleEntity, config) end

---Crea un comando para enviar un vehículo al depósito
---@param vehicleEntity integer ID de la entidad del vehículo
---@param sellOnArrival boolean Si se vende al llegar al depósito
---@return table Comando SendToDepot
function api.cmd.make.sendToDepot(vehicleEntity, sellOnArrival) end

---Crea un comando para enviar evento de script
---@param fileName string Nombre del archivo de script
---@param id string Identificador del elemento
---@param data? table Datos del evento
---@return table Comando SendScriptEvent
function api.cmd.make.sendScriptEvent(fileName, id, data) end

---Crea un comando para establecer estado de animal
---@param animalEntity integer ID de la entidad del animal
---@param movementType integer Tipo de movimiento
---@param targetChangedElapsed number Tiempo desde cambio de objetivo
---@param invalidTileElapsed number Tiempo en área inválida
---@param movementSpeed number Velocidad de movimiento
---@param angularSpeed number Velocidad angular
---@return table Comando SetAnimalState
function api.cmd.make.setAnimalState(animalEntity, movementType, targetChangedElapsed, invalidTileElapsed, movementSpeed, angularSpeed) end

---Crea un comando para generar un animal
---@param modelPath string Ruta al modelo del animal
---@param position Vec2f Posición donde generar el animal
---@return table Comando SpawnAnimal
function api.cmd.make.spawnAnimal(modelPath, position) end

-- ========================================
-- API.ENGINE - Estado del motor
-- ========================================

---@class api.engine
api.engine = {}

---@class api.engine.system
api.engine.system = {}

---@class api.engine.util
api.engine.util = {}

---@class api.engine.util.pathfinding
api.engine.util.pathfinding = {}

---@class api.engine.terrain
api.engine.terrain = {}

---Verifica si una entidad existe
---@param entity integer ID de la entidad
---@return boolean True si la entidad existe
function api.engine.entityExists(entity) end

---Obtiene un componente de una entidad
---@param entity integer ID de la entidad
---@param componentType integer Tipo de componente (ComponentType)
---@return table|nil El componente si existe
function api.engine.getComponent(entity, componentType) end

---Itera sobre cada entidad en el motor
---@param callback fun(entity: integer) Función de callback para cada entidad
function api.engine.forEachEntity(callback) end

---Itera sobre entidades con un componente específico
---@param callback fun(entity: integer, component: table) Función de callback
---@param componentType integer Tipo de componente para filtrar
function api.engine.forEachEntityWithComponent(callback, componentType) end

---Obtiene la revisión de una entidad
---@param entity integer ID de la entidad
---@return integer Número de revisión
function api.engine.getEntityRevision(entity) end

-- Sistemas
---@class AircraftMoveSystem
api.engine.system.aircraftMoveSystem = {}

---@class TransportNetworkSystem
api.engine.system.transportNetworkSystem = {}

---@class TransportVehicleSystem
api.engine.system.transportVehicleSystem = {}

---@class SimEntityAtStockSystem
api.engine.system.simEntityAtStockSystem = {}

---Obtiene la cantidad de stock de una entidad
---@param stockEntity integer ID de la entidad de stock
---@param cargoType integer Tipo de carga
---@return number Cantidad de stock
function api.engine.system.simEntityAtStockSystem.getStockCount(stockEntity, cargoType) end

-- Utilidades de pathfinding
---Encuentra una ruta entre bordes y nodos
---@param fromEdges table Lista de EdgeIdDirAndLength
---@param toNodes table Lista de NodeId
---@param options table Opciones de pathfinding
---@param maxDistance number Distancia máxima
---@return table|nil Ruta encontrada o nil
function api.engine.util.pathfinding.findPath(fromEdges, toNodes, options, maxDistance) end

-- Terreno
---Verifica si una coordenada es válida
---@param coordinate Vec2f Coordenada a verificar
---@return boolean True si es válida
function api.engine.terrain.isValidCoordinate(coordinate) end

