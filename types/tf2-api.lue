-- Componentes GUI
---@class Component
---@field setId fun(self: Component, id: string): Component
---@field setName fun(self: Component, name: string): Component
---@field setTooltip fun(self: Component, text: string): Component
---@field setVisible fun(self: Component, visible: boolean): Component
---@field setStyleClass fun(self: Component, classes: string[]): Component
---@field setTransparent fun(self: Component, transparent: boolean): Component
local Component = {}

---@class Slider : Component
---@field onValueChanged fun(self: Slider, callback: fun(value: number)): Connection
local Slider = {}

---Crea un nuevo slider
---@param orientation "HORIZONTAL"|"VERTICAL" Orientación del slider
---@return Slider
function api.gui.comp.Slider.new(orientation) end

---@class Window : Component
---@field addDefaultHandler fun(self: Window): Window
---@field close fun(self: Window): Window
---@field getContent fun(self: Window): Component
---@field isAttached fun(self: Window): boolean
---@field isPinnable fun(self: Window): boolean
---@field isPinned fun(self: Window): boolean
---@field maximize fun(self: Window): Window
---@field minimize fun(self: Window): Window
---@field setContent fun(self: Window, content: Component): Window
local Window = {}

---Crea una nueva ventana
---@param title string Título de la ventana
---@return Window
function api.gui.comp.Window.new(title) end

-- Utilidades GUI
---@class Rect
---@field x number
---@field y number
---@field w number
---@field h number
---@field contains fun(self: Rect, pos: Vec2f): boolean
---@field intersects fun(self: Rect, other: Rect): boolean
local Rect = {}

---Crea un nuevo rectángulo
---@param x? number Coordenada X
---@param y? number Coordenada Y
---@param w? number Ancho
---@param h? number Alto
---@return Rect
function api.gui.util.Rect.new(x, y, w, h) end

---Obtiene un elemento por ID
---@param id string ID del elemento UI
---@return Component|nil El componente si existe
function api.gui.util.getById(id) end

