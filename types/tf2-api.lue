    BUILD_COST = 11,
    COLLIDER_LIST = 12,
    CONSTRUCTION = 13,
    EMISSION_GRID = 14,
    GAME_SPEED = 15,
    GAME_TIME = 16,
    TRANSPORT_VEHICLE = 67,
    -- ... más tipos disponibles
}

